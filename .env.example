# Copy to .env (git-ignored). Everything works offline with no .env at all.

# --- AI coach ---------------------------------------------------------------
# "test" = built-in rule-based coach: free, no key, never runs out.
AI_MODEL=test
# Free real LLM: Gemini free tier. Get a key at https://aistudio.google.com/apikey
# and do NOT enable billing on that Google project, so it can never charge you.
# flash-lite has the most generous free quota. (2.5 models are retired for new keys.)
# Several free models, tried in order when one is busy (503) or out of quota (429):
# AI_MODEL=google:gemini-3.5-flash-lite,google:gemini-3.5-flash
# GOOGLE_API_KEY=

# When the real model is out of free quota, slow, or failing, answer with the
# offline coach instead of an error. Set to "off" to see the real errors.
AI_FALLBACK=baseline

# Other providers (paid):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional hard spend cap per AI run, in USD (paid providers only):
# AI_COST_LIMIT_USD=0.05

# --- Product analytics (PostHog) -------------------------------------------------
# Off unless set. Use your project's API key (starts with "phc_") from
# PostHog → Project settings. EU projects use https://eu.i.posthog.com.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Host ports ---------------------------------------------------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
